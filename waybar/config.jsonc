{
    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    // "width": 1280, // Waybar width
    // Choose the order of the modules
    "modules-left": ["sway/workspaces"],
    // "modules-center": ["clock"],
    "modules-right": [ "custom/lid_standby", "idle_inhibitor", "bluetooth", "pulseaudio", "network", "sway/language", "backlight", "battery", "clock",  "tray"],
    "tray": {
        "icon-size": 21,
        "spacing": 10
    },
    // Toggles suspend-on-lid-close. Icon shows the CURRENT behaviour:
    //   closed lid  = closing the lid suspends
    //   open lid    = closing the lid keeps the machine awake
    "custom/lid_standby": {
        "return-type": "json",
        "exec": "$HOME/.config/sway/scripts/lid-standby status",
        "on-click": "$HOME/.config/sway/scripts/lid-standby toggle",
        // Re-read on SIGRTMIN+8, which the script raises after a toggle so the
        // icon updates instantly; the interval is just a slow safety net in
        // case the inhibitor dies behind our back.
        "signal": 8,
        "interval": 30,
        "tooltip": true
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": " ",
            "deactivated": " "
        }
    },
    "bluetooth": {
        "format": "",
				"format-connected": " {device_alias}"
		},
		"backlight": {
			"on-scroll-up" : "brightnessctl set +10%",
			"on-scroll-down" : "brightnessctl set 10%-",
			"format": "{percent}% {icon}",
			"format-icons": ["", ""]
		},
		"sway/language" : {
			"format": "{short} {variant}"
		},
    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%H:%M - %d/%m/%Y}",
        "format": "{:%H:%M}"
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 20,
        },
        "format": "{icon} {capacity}%",
        "format-full": "{icon} {capacity}% ",
        "format-charging": " {capacity}% ",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        "format-icons": ["", "", "", "", ""]
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{icon} {volume}%",
        "format-muted": "",
        "format-icons": {
            "default": ["", "", " "]
        },
        "on-click": "pavucontrol"
    },
    "network": {
        // "format-wifi": "{essid} ({signalStrength}%) ",
        "format-wifi": "  {signalStrength}%",
        "format-ethernet": "{ipaddr}/{cidr} ",
        // "tooltip-format": "{ifname} via {gwaddr} ",
        "tooltip-format": "{essid}",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "Disconnected ⚠", 
	      "on-click": "foot --app-id=wlctl $HOME/.cargo/bin/wlctl",
	},
}
